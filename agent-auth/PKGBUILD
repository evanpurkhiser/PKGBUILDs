# Maintainer: Evan Purkhiser <agent-auth.aur@evanpurkhiser.com>

pkgname=agent-auth
pkgver=0.1.1
pkgrel=1
pkgdesc="Context-aware routing and authorization for SSH agent requests"
arch=('any')
url="https://github.com/evanpurkhiser/agent-auth"
license=('MIT')
depends=('openssh' 'python' 'tailscale')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=()
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('7b0b587dac63daa95555f534d689682e555871e8a8a7b8e601c56f2a8c16d4b7')

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	python -m build --wheel --no-isolation
}

check() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	PYTHONPATH=src python -m unittest discover -s tests -v
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	python -m installer --destdir="${pkgdir}" dist/*.whl

	install -Dm644 systemd/ssh-agent-proxy.socket \
		"${pkgdir}/usr/lib/systemd/system/ssh-agent-proxy.socket"
	install -Dm644 systemd/ssh-agent-proxy@.service \
		"${pkgdir}/usr/lib/systemd/system/ssh-agent-proxy@.service"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
