# Maintainer: Evan Purkhiser <agent-witness.aur@evanpurkhiser.com>

pkgname=agent-witness
pkgver=0.1.2
pkgrel=2
pkgdesc="Remote SSH agent with phone-based authorization"
arch=('x86_64')
url="https://github.com/evanpurkhiser/agent-witness"
license=('MIT')
depends=('ca-certificates' 'gcc-libs' 'glibc' 'openssl')
makedepends=('cargo' 'nodejs' 'pnpm' 'pkgconf')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('cdbbf05219ff65fae8bc53b81b74e2a41f351b37d1b9b036deef466c35ec0bb8')

prepare() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	pnpm install --frozen-lockfile
	cargo fetch --locked
}

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	pnpm build:production
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	install -Dm755 target/release/agent-witness "${pkgdir}/usr/bin/agent-witness"
	install -Dm644 systemd/agent-witness.service \
		"${pkgdir}/usr/lib/systemd/system/agent-witness.service"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
