# Maintainer: Evan Purkhiser <psst.aur@evanpurkhiser.com>

pkgname=psst
pkgver=0.3.1
pkgrel=1
pkgdesc="Short-lived local sessions for 1Password item-sharing links"
arch=('x86_64' 'aarch64')
url="https://github.com/evanpurkhiser/psst"
license=('MIT')
depends=('gcc-libs' 'glibc' 'systemd')
makedepends=('cargo' 'musl' 'rust-musl')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
	"${pkgname}-chrome-extension-${pkgver}.crx::${url}/releases/download/v${pkgver}/psst-chrome-extension.crx")
sha256sums=('96848425e0cc5367b51ba86bf32c4583e8519a552957e9fca12448255ceaa3f4'
	'7cd9b185976b37ebaba5c4372fdd436bfe557811ee68ae4f76d33fad1c8d5680')

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	PSST_BROWSER_BRIDGE_PATH=/usr/lib/psst/browser-bridge \
		PSST_BROWSER_EXTENSION_PATH=/usr/lib/psst/chrome-extension.crx \
		cargo build --release --locked
	PSST_BROWSER_BRIDGE_TARGET="${CARCH}-unknown-linux-musl" ./scripts/build-browser-bridge
}

check() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	cargo test --release --locked --workspace --all-targets
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	install -Dm755 target/release/psst "${pkgdir}/usr/bin/psst"
	install -Dm755 "target/${CARCH}-unknown-linux-musl/release/psst-browser-bridge" "${pkgdir}/usr/lib/psst/browser-bridge"
	install -Dm644 "${srcdir}/${pkgname}-chrome-extension-${pkgver}.crx" "${pkgdir}/usr/lib/psst/chrome-extension.crx"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
