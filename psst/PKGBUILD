# Maintainer: Evan Purkhiser <psst.aur@evanpurkhiser.com>

pkgname=psst
pkgver=0.1.2
pkgrel=1
pkgdesc="Short-lived local sessions for 1Password item-sharing links"
arch=('x86_64' 'aarch64')
url="https://github.com/evanpurkhiser/psst"
license=('MIT')
depends=('gcc-libs' 'glibc' 'systemd')
makedepends=('cargo')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('22250e9990cef189d14c523e0e2f7925940108a9b97517008b99e10fe2092b0a')

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	cargo build --release --locked
}

check() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	cargo test --release --locked --all-targets
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	install -Dm755 target/release/psst "${pkgdir}/usr/bin/psst"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
